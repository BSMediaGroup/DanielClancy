# =====================================================
# DEVELOPER + MAINTENANCE ACCESS
# =====================================================
AUTH_ACCESS_MODE=normal|maintenance|development|beta
AUTH_ACCESS_MESSAGE="Sample lockout message"
SHOW_LOCKOUT_BANNER=false
AUTH_ACCESS_BYPASS_ENABLED=true
ADMIN_DEBUG_BYPASS_CODE=
AUTH_ACCESS_BYPASS_TTL_MINUTES=15


# Public runtime hydration for Projects/Companies/Platforms/Positions.
# Without this value the public site uses the committed fallback snapshot only.
VITE_ADMIN_PUBLIC_SITE_DATA_URL=https://admin.danielclancy.net/api/public/site-data


# =====================================================
# CLOUDFLARE TURNSTILE
# =====================================================
# Site key may be exposed through the /api/turnstile/config Pages Function.
# Secret key must remain server-side only.
DC_TURNSTILE_SITE_KEY=
DC_TURNSTILE_SECRET_KEY=
DC_TURNSTILE_DEV_BYPASS=false

# DANIELCLANCY ALERT INGEST
# Server-only bridge to StreamSuites /api/alerts/danielclancy.
DANIELCLANCY_ALERT_INGEST_URL=
DANIELCLANCY_ALERT_INGEST_SECRET=

# DANIELCLANCY ADMIN ANALYTICS INGEST
# Server-only forwarding from /api/track/page-visit to DanielClancy-Admin.
# Expected URL:
# https://admin.danielclancy.net/api/analytics/ingest/page-visit
DANIELCLANCY_ADMIN_ANALYTICS_INGEST_URL=
# Generate separately from alert ingest unless intentionally reusing:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DANIELCLANCY_ANALYTICS_INGEST_SECRET=


# =====================================================
# CREATOR: DANIEL
# =====================================================

# -----------------------------------------------------
# RUMBLE – LIVESTREAM METADATA (READ / DISCOVERY)
# -----------------------------------------------------
# Used for:
# - detecting if the stream is live
# - retrieving livestream metadata
# - discovering chat room IDs
#
# NOTE:
# - This is a READ-ONLY capability
# - One key per Rumble USER account
# - Does NOT allow chat posting
# -----------------------------------------------------
RUMBLE_LIVESTREAM_KEY_DANIEL=


# -----------------------------------------------------
# RUMBLE – AUTH COOKIES (AUTHORITATIVE)
# -----------------------------------------------------

RUMBLE_BOT_SESSION_COOKIE_DANIEL=
RUMBLE_U_S=
RUMBLE_A_S=
RUMBLE_CF_CLEARANCE=
RUMBLE_CF_BM=


# -----------------------------------------------------
# YOUTUBE – DATA + CHAT (BOT USER CONTEXT)
# -----------------------------------------------------
# Used for:
# - livestream detection
# - reading chat
# - future uploads if enabled
# - future /watch page ingestion in the public-site scaffold
# -----------------------------------------------------
YOUTUBE_API_KEY_DANIEL=
YOUTUBE_CHANNEL_ID_DANIEL=


# -----------------------------------------------------
# X (TWITTER) 
# -----------------------------------------------------
#
# NOTE:
# - OAuth 2.0 user context
# - Bearer token NOT required
# -----------------------------------------------------
X_CLIENT_ID_DANIEL=
X_CLIENT_SECRET_DANIEL=
X_USER_ACCESS_TOKEN_DANIEL=
X_USER_ACCESS_SECRET_DANIEL=

X_APP_ID=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

X_ADMIN_HANDLE=@DanielClancy


# =====================================================
# EMAIL VERIFICATION SERVICE - RESEND
# =====================================================
RESEND_API_KEY=
MAIL_FROM="DC Notifications <alerts@notify.danielclancy.net>"
MAIL_REPLY_TO=mail@danielclancy.net


# =====================================================
# STRIPE PAYMENT SETTINGS
# =====================================================
STRIPE_SECRET_KEY=
# Existing donation/payment webhook signing secret.
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_LIVE_ENABLED=true

# Merch-specific Stripe webhook signing secret for /api/merch/stripe/webhook.
STRIPE_MERCH_WEBHOOK_SECRET=

# Cloudflare KV binding name for durable merch order intents.
# Configure this as a Pages KV binding, not a public browser variable.
DC_MERCH_ORDERS_KV=

# Cloudflare KV binding name for public customer profiles, passwordless login
# challenges, sessions, delivery addresses, preferences, order links, and
# Stripe customer mapping. Configure as:
# DC_CUSTOMERS_KV -> danielclancy-customers
DC_CUSTOMERS_KV=


# =====================================================
# PAYPAL PAYMENT SETTINGS
# =====================================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_APP_NAME=DanielClancyNet
PAYPAL_LIVE_ENABLED=true


PRINTFUL_STORE_API=
CURRENCY_RATES_API_URL=https://api.frankfurter.dev/v1/latest?base=AUD
