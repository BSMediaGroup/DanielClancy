{
  "name": "daniel-clancy-public-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "data:rebuild": "node tools/rebuild-public-fallback.mjs",
    "data:check": "node tools/rebuild-public-fallback.mjs --check",
    "build:with-data": "npm run data:rebuild && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.30.1"
  },
  "overrides": {
    "@mapbox/jsonlint-lines-primitives": "2.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.19"
  }
}
